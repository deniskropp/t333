{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deniskropp/t333/canon/schemas/error.schema.json",
  "title": "Error",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string"
    },
    "details": {
      "type": "object"
    },
    "retryable": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "code",
    "message"
  ],
  "additionalProperties": false
}
